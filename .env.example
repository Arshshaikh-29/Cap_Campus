# =====================================================================
# CAP COMPASS — PRODUCTION SECURITY CONFIGURATION
# Copy this file to `.env` before deploying publicly and change secrets!
# =====================================================================

# Set to "production" when deploying publicly (disables /docs & /openapi.json)
CAP_ENV=development

# Strong secret password/PIN for the Owner Revenue Dashboard (/admin)
# IMPORTANT: Change this to a strong 12+ character passphrase before going live!
CAP_ADMIN_PIN=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD

# 64-character random hex secret for HMAC-SHA256 admin & Pro entitlement tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CAP_SIGNING_SECRET=CHANGE_ME_TO_64_HEX_CHARACTERS_RANDOM_SECRET

# Comma-separated list of allowed frontend origins (NO trailing slashes, NEVER "*")
CAP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to "1" ONLY if running behind a trusted reverse proxy (Cloudflare / Nginx / Vercel)
CAP_TRUST_PROXY=0

# Google OAuth 2.0 Web Client ID for the Student Google Sign-In Portal (/login)
# Create free at https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID -> Web application)
# Add Authorized JavaScript Origins: http://localhost:3000 and https://cap-campus.vercel.app
GOOGLE_CLIENT_ID=
# Also set NEXT_PUBLIC_GOOGLE_CLIENT_ID=<same client id> in frontend/.env.local & Vercel Environment Variables
