# =====================================================================
# CAP COMPASS — PRODUCTION SECURITY CONFIGURATION
# Copy this file to `.env` before deploying publicly and change secrets!
# =====================================================================

# Set to "production" when deploying publicly (disables /docs & /openapi.json)
CAP_ENV=development

# Strong secret password/PIN for the Owner Revenue Dashboard (/admin)
# PREFERRED: Store a salted PBKDF2-HMAC-SHA256 hash instead of plaintext:
#   python -c "from backend.api.security import hash_secret; print(hash_secret('YOUR_STRONG_PASS'))"
CAP_ADMIN_PIN_HASH=
# Legacy fallback (must be >= 8 chars and NOT 992062 in production; fail-closed otherwise!)
CAP_ADMIN_PIN=

# Comma-separated owner Gmail addresses automatically granted super_admin RBAC on Google Sign-In
CAP_SUPERADMIN_EMAILS=

# 64-character random hex secret for HMAC-SHA256 admin & Pro entitlement tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
CAP_SIGNING_SECRET=CHANGE_ME_TO_64_HEX_CHARACTERS_RANDOM_SECRET

# Comma-separated list of allowed frontend origins (NO trailing slashes, NEVER "*")
CAP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to "1" ONLY if running behind a trusted reverse proxy (Cloudflare / Nginx / Vercel)
CAP_TRUST_PROXY=0

# Google OAuth 2.0 Web Client ID for the Student Google Sign-In Portal (/login)
# Create free at https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID -> Web application)
# Add Authorized JavaScript Origins: http://localhost:3000 and https://cap-campus.vercel.app
GOOGLE_CLIENT_ID=
# Also set NEXT_PUBLIC_GOOGLE_CLIENT_ID=<same client id> in frontend/.env.local & Vercel Environment Variables

# Razorpay Instant Payment Gateway (UPI / GPay / PhonePe / Paytm / Cards -> Auto-Unlock Pro/VIP!)
# Create free account at https://dashboard.razorpay.com -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional server-to-server webhook secret (Dashboard -> Webhooks -> https://cap-campus.onrender.com/api/payments/razorpay/webhook)
RAZORPAY_WEBHOOK_SECRET=

# Persistent Cloud PostgreSQL Database URL for live Users, Shortlists, Orders, Leads & Option Forms
# Free providers: Neon (https://neon.tech) or Supabase (https://supabase.com) or Render PostgreSQL
# Example: postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Leave blank locally to use SQLite automatically.
DATABASE_URL=
