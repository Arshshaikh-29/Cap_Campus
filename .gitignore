# Secrets & environment config (NEVER commit!)
.env
.env.*
!.env.example
.cap_secret.key

# Databases (keep root cap_compass.sqlite3 tracked for Render deploy; never commit WAL/SHM or duplicates)
*.sqlite3
!cap_compass.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db

# Temporary archives & backup snapshots (never expose in public repo)
temp_zip/
*.zip
*.bak

# Python & Node build artifacts
__pycache__/
*.pyc
.pytest_cache/
frontend/node_modules/
frontend/.next/
frontend/out/
*.log
