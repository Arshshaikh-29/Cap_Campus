# Secrets & environment config (NEVER commit!)
.env
.env.*
!.env.example
.cap_secret.key

# Databases (keep public DTE cutoff SQLite DBs tracked for Render deploy; never commit WAL/SHM or backups)
*.sqlite3
!cap_compass.sqlite3
!backend/cap_compass.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.db

# Python & Node build artifacts
__pycache__/
*.pyc
.pytest_cache/
frontend/node_modules/
frontend/.next/
frontend/out/
*.log
